{
	"name": "Crit DevContainer",
	"dockerComposeFile": "docker-compose.yaml",
	"service": "dev",
	"workspaceFolder": "/workspace",
	"remoteUser": "root",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.vscode-dotnet-runtime",
				"ms-azuretools.vscode-containers",
				"ms-dotnettools.csharp",
				"ms-vscode.vscode-typescript-next",
				"ms-azuretools.vscode-docker",
				"GitHub.copilot-chat",
				"msjsdiag.vscode-react-native",
				"ms-azuretools.vscode-containers",
				"ms-dotnettools.csdevkit",
				"fernandoescolar.vscode-solution-explorer",
				"yzhang.markdown-all-in-one",
				"bierner.markdown-emoji",
				"bierner.markdown-checkbox"
			],
			"settings": {
				"dotnet.defaultSolution": "/workspace/crit-api/CritApi.sln",
				"razor.disabled": true,
				"dotnet.server.useOmnisharp": false,
				"csharp.server.runtime": "net",
				"dotnet.sdk.enablePreviewVersions": false,
				"dotnetAcquisitionExtension.enableSdkPreview": false,
				"dotnetAcquisitionExtension.requiredVersion": "8.0",
				"dotnet.runtime": "8.0"
			}
		}
	},
	"postCreateCommand": "bash .devcontainer/setup.sh",
	"shutdownAction": "stopCompose",
	"containerEnv": {
		"NUGET_FALLBACK_PACKAGES": "",
		"NUGET_PACKAGES": "/root/.nuget/packages",
		"HOME": "/root",
		"DOCKER_HOST": "unix:///var/run/docker.sock"
	},
	"overrideCommand": false,
	"mounts": [
		"source=/etc/localtime,target=/etc/localtime,type=bind,readonly",
		"source=/usr/share/zoneinfo,target=/usr/share/zoneinfo,type=bind,readonly"
	]
}